.fiberterm-brand
  display flex
  align-items center
  gap 20px
  color inherit

.fiberhome-official-logo
  display block
  width 182px
  height auto
  max-width 44vw
  flex 0 1 auto

.fiberterm-brand-copy
  display flex
  flex-direction column
  min-width 0

.fiberterm-name-row
  display flex
  align-items center
  gap 12px
  flex-wrap wrap

.fiberterm-product-name
  font-size 38px
  font-weight 650
  line-height 1.15
  letter-spacing -.8px

.fiberterm-company
  font-size 15px
  font-weight 400
  opacity .62

.fiberterm-tagline
  margin-top 6px
  font-size 15px
  font-weight 400
  letter-spacing 2px
  opacity .72

@media (max-width: 500px)
  .fiberterm-brand
    gap 12px
  .fiberhome-official-logo
    width 126px
  .fiberterm-product-name
    font-size 26px
  .fiberterm-tagline
    font-size 12px
    letter-spacing 1px
